generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  // Prisma CLI only accepts file: URLs. For Turso at runtime, set DATABASE_URL to
  // libsql://... (or https://...) and the app uses @prisma/adapter-libsql.
  // Keep file:./dev.db for local CLI (generate / db push / seed).
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("vendedor") // superadmin | admin | vendedor | contador
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  passwordResetTokens PasswordResetToken[]
}

model Company {
  id                String @id @default(cuid())
  name              String // razón social
  nit               String
  address           String @default("")
  phone             String @default("")
  email             String @default("")
  logoUrl           String @default("/logo-bunuelandia.png")
  invoicePrefix     String @default("FV")
  nextInvoiceNumber Int    @default(1)
  quotePrefix       String @default("COT")
  nextQuoteNumber   Int    @default(1)
  unpaidAlertDays   Int    @default(30)
  stockAlertEmails  String @default("") // comma-separated; stock low alerts
  cashCloseEmails   String @default("") // comma-separated; daily cash close notices
}

model Product {
  id         String          @id @default(cuid())
  sku        String          @unique
  name       String
  price      Float // COP sin IVA
  ivaRate    Float           @default(19) // porcentaje
  stock      Float           @default(0)
  minStock   Float           @default(5)
  trackStock Boolean         @default(true)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  items      InvoiceItem[]
  quoteItems QuoteItem[]
  movements  StockMovement[]
}


model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  /// in | out | adjust
  type        String
  /// Always positive; direction comes from type
  quantity    Float
  stockBefore Float
  stockAfter  Float
  reason      String   @default("")
  /// invoice | adjust | manual
  refType     String   @default("")
  refId       String   @default("")
  refNumber   String   @default("")
  userId      String?
  userEmail   String   @default("")
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  nit       String // NIT o CC
  email     String    @default("")
  phone     String    @default("")
  address   String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  quotes    Quote[]
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique // e.g. FV-0001
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  status     String        @default("draft") // draft|issued|paid|void
  subtotal   Float         @default(0)
  ivaTotal   Float         @default(0)
  total      Float         @default(0)
  notes         String        @default("")
  paymentMethod String        @default("") // efectivo|transferencia|tarjeta|otro|""
  quoteId       String?
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  payments      Payment[]
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  description  String
  quantity     Float
  unitPrice    Float
  ivaRate      Float    @default(19)
  lineSubtotal Float
  lineIva      Float
  lineTotal    Float
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("transferencia") // efectivo|transferencia|tarjeta|otro
  paidAt    DateTime @default(now())
  notes     String   @default("")
  createdAt DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  date      DateTime
  category  String
  amount    Float
  notes     String   @default("")
  createdAt DateTime @default(now())
}

model Quote {
  id         String      @id @default(cuid())
  number     String      @unique
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     String      @default("draft") // draft|sent|accepted|rejected|converted
  subtotal   Float       @default(0)
  ivaTotal   Float       @default(0)
  total      Float       @default(0)
  notes      String      @default("")
  validUntil DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      QuoteItem[]
}

model QuoteItem {
  id           String   @id @default(cuid())
  quoteId      String
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  description  String
  quantity     Float
  unitPrice    Float
  ivaRate      Float    @default(19)
  lineSubtotal Float
  lineIva      Float
  lineTotal    Float
}


model CashClose {
  id             String   @id @default(cuid())
  /// Calendar day in America/Bogotá as YYYY-MM-DD (unique).
  date           String   @unique
  expectedCash   Float    @default(0)
  countedCash    Float    @default(0)
  difference     Float    @default(0)
  notes          String   @default("")
  closedByUserId String?
  closedByEmail  String   @default("")
  status         String   @default("closed") // open|closed
  /// JSON: { efectivo, transferencia, tarjeta, otro, expensesTotal, cashExpenses }
  breakdownJson  String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String   @default("")
  action     String // create|update|delete|adjust|issue|void|convert|login
  entity     String // product|customer|invoice|quote|expense|company|user|payment|stock
  entityId   String   @default("")
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String   @default("")
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Supply {
  id        String   @id @default(cuid())
  code      String   @unique  // short code e.g. HAR-01
  name      String
  category  String   @default("otro") // harina|queso|salsa|aceite|empaque|otro
  unit      String   @default("unidad") // kg|g|L|ml|unidad|caja|paquete
  quantity  Float    @default(0)
  minStock  Float    @default(0)
  unitCost  Float    @default(0) // COP optional
  notes     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movements SupplyMovement[]
}

model SupplyMovement {
  id             String   @id @default(cuid())
  supplyId       String
  supply         Supply   @relation(fields: [supplyId], references: [id])
  type           String   // in | out | adjust
  quantity       Float    // always positive
  quantityBefore Float
  quantityAfter  Float
  reason         String   @default("")
  userId         String?
  userEmail      String   @default("")
  createdAt      DateTime @default(now())

  @@index([supplyId])
  @@index([createdAt])
}

