# Local SQLite (default). Path is relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# --- Turso (production / Vercel) ---
# Uncomment and set these instead of the file: URL above:
# DATABASE_URL="libsql://YOUR-DB-NAME-YOUR-ORG.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."
# (alias also supported)
# DATABASE_AUTH_TOKEN="eyJ..."

AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public app URL (used in password-reset email links). No trailing slash.
APP_URL="https://your-app.vercel.app"

# Resend (password recovery emails)
RESEND_API_KEY="re_xxxxxxxx"
# Testing: onboarding@resend.dev — production: your verified domain sender
RESEND_FROM="Buñuelandia <onboarding@resend.dev>"

# Optional: comma-separated fallbacks if Company fields are empty
# STOCK_ALERT_EMAILS="bodega@empresa.com"
# CASH_CLOSE_EMAILS="caja@empresa.com"

# --- Respaldo diario automático (Vercel Cron -> /api/cron/backup) ---
# Secreto aleatorio (>=16 chars, recomendado 32+). Vercel lo envía como
# "Authorization: Bearer <CRON_SECRET>" en cada ejecución del cron.
# CRON_SECRET="generate-with-openssl-rand-hex-32"
# Destinatarios del ZIP diario (coma). Si falta, usa el email de la empresa.
# BACKUP_EMAILS="admin@empresa.com"
